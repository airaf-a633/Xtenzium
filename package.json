{
  "name": "xtenzium-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check": "npm run check:deals && npm run check:tasks && npm run check:views && npm run check:command && npm run check:realtime && npm run check:reporting",
    "check:deals": "npx --yes esbuild checks/deals.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deals.check.mjs --log-level=warning && node node_modules/.cache/deals.check.mjs",
    "check:tasks": "npx --yes esbuild checks/tasks.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tasks.check.mjs --log-level=warning && node node_modules/.cache/tasks.check.mjs",
    "check:views": "npx --yes esbuild checks/views.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/views.check.mjs --log-level=warning && node node_modules/.cache/views.check.mjs",
    "check:command": "npx --yes esbuild checks/command.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/command.check.mjs --log-level=warning && node node_modules/.cache/command.check.mjs",
    "check:realtime": "npx --yes esbuild checks/realtime.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/realtime.check.mjs --log-level=warning && node node_modules/.cache/realtime.check.mjs",
    "check:reporting": "npx --yes esbuild checks/reporting.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/reporting.check.mjs --log-level=warning && node node_modules/.cache/reporting.check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/extension-character-count": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/three": "^0.184.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.8.0",
    "ogl": "^1.0.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9"
  }
}

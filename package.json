{
  "name": "xtenzium-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-all.mjs",
    "build:crm-only": "tsc -b && vite build",
    "lint": "eslint .",
    "test:db": "node e2e/db-suite.mjs",
    "e2e:api": "node e2e/shim.mjs",
    "e2e:web": "vite --mode e2e --port 5180",
    "check": "npm run check:deals && npm run check:tasks && npm run check:views && npm run check:command && npm run check:realtime && npm run check:reporting && npm run check:roles && npm run check:dialer-import && npm run check:dialer-calls && npm run check:meeting-slots && npm run check:google && npm run check:outreach && npm run check:touch-ics-summary && npm run check:summary-api && npm run check:auth-guard && npm run check:auth-health && npm run check:app-update",
    "check:deals": "npx --yes esbuild checks/deals.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deals.check.mjs --log-level=warning && node node_modules/.cache/deals.check.mjs",
    "check:tasks": "npx --yes esbuild checks/tasks.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tasks.check.mjs --log-level=warning && node node_modules/.cache/tasks.check.mjs",
    "check:views": "npx --yes esbuild checks/views.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/views.check.mjs --log-level=warning && node node_modules/.cache/views.check.mjs",
    "check:command": "npx --yes esbuild checks/command.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/command.check.mjs --log-level=warning && node node_modules/.cache/command.check.mjs",
    "check:realtime": "npx --yes esbuild checks/realtime.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/realtime.check.mjs --log-level=warning && node node_modules/.cache/realtime.check.mjs",
    "check:reporting": "npx --yes esbuild checks/reporting.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/reporting.check.mjs --log-level=warning && node node_modules/.cache/reporting.check.mjs",
    "check:roles": "npx --yes esbuild checks/roles.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/roles.check.mjs --log-level=warning && node node_modules/.cache/roles.check.mjs",
    "check:dialer-import": "npx --yes esbuild checks/dialer-import.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dialer-import.check.mjs --log-level=warning && node node_modules/.cache/dialer-import.check.mjs",
    "check:dialer-calls": "npx --yes esbuild checks/dialer-calls.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dialer-calls.check.mjs --log-level=warning && node node_modules/.cache/dialer-calls.check.mjs",
    "check:meeting-slots": "npx --yes esbuild checks/meeting-slots.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/meeting-slots.check.mjs --log-level=warning && node node_modules/.cache/meeting-slots.check.mjs",
    "check:google": "npx --yes esbuild checks/google.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/google.check.mjs --log-level=warning && node node_modules/.cache/google.check.mjs",
    "check:outreach": "npx --yes esbuild checks/outreach.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/outreach.check.mjs --log-level=warning && node node_modules/.cache/outreach.check.mjs",
    "check:touch-ics-summary": "npx --yes esbuild checks/touch-ics-summary.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/touch-ics-summary.check.mjs --log-level=warning && node node_modules/.cache/touch-ics-summary.check.mjs",
    "check:summary-api": "npx --yes esbuild checks/summary-api.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/summary-api.check.mjs --log-level=warning && node node_modules/.cache/summary-api.check.mjs",
    "check:auth-guard": "npx --yes esbuild checks/auth-guard.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/auth-guard.check.mjs --log-level=warning && node node_modules/.cache/auth-guard.check.mjs",
    "check:app-update": "npx --yes esbuild checks/app-update.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/app-update.check.mjs --log-level=warning && node node_modules/.cache/app-update.check.mjs",
    "check:auth-health": "npx --yes esbuild checks/auth-health.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/auth-health.check.mjs --log-level=warning && node node_modules/.cache/auth-health.check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/extension-character-count": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "clsx": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9"
  }
}

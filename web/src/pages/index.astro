---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatementPanel from '../components/StatementPanel.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import StackingCards from '../components/StackingCards.astro';
import Coverflow from '../components/Coverflow.astro';
import Testimonial from '../components/Testimonial.astro';
import WatermarkX from '../components/WatermarkX.astro';
import { unverified } from '../lib/placeholder';
import { getWork, publishable } from '../lib/content';
import { credits } from '../data/credits';
import { services as servicesData } from '../data/services';
import { imagery } from '../data/imagery';
import { serviceImage } from '../data/imagery';

const heroLines = ['We architect', 'long-term', 'success.'];

const capabilities = [
  'React', 'Next.js', 'Astro', 'TypeScript', 'Node.js', 'PostgreSQL',
  'Supabase', 'Tailwind', 'GSAP', 'Figma', 'KiCad', 'Altium',
  'ESP32', 'STM32', 'LoRaWAN', 'MQTT', 'AWS', 'Vercel',
];

// Single source of truth — the same data the /services pages render from,
// so a service can never exist on one and not the other.
const services = servicesData
  .slice()
  .sort((a, b) => a.order - b.order)
  .map((sv) => ({
    kicker: sv.kicker,
    title: sv.title,
    href: `/services/${sv.slug}`,
    body: sv.summary,
    image: serviceImage(sv.slug),
  }));

// A real sequence, so the numbering carries information the reader needs.
//
// Each step carries art matched to what that step actually is — the plot
// for scoping, the type grid for design, modules for the build, a routed
// graph for handover. Without an image these cards rendered as a column
// of text beside an empty half, which is what made the section read as
// unfinished.
const process = [
  { n: '01', title: 'Scope', body: 'We sit with your team and map what actually needs building. You leave with a written scope and a number, free.', image: '/art/service-consultancy.svg' },
  { n: '02', title: 'Design', body: 'Interface and system design, reviewed with you weekly. Nothing gets built from a guess.', image: '/art/service-design.svg' },
  { n: '03', title: 'Build', body: 'Two-week cycles with a working link at the end of each one. You watch it come together.', image: '/art/service-development.svg' },
  { n: '04', title: 'Handover', body: 'Documented, audited, and yours. Every credential, every repo, every decision written down.', image: '/art/service-automation.svg' },
];

/**
 * Selected work, from the same source /work reads.
 *
 * This used to be three hardcoded clients — Meridian, Aster, Kiln — with
 * outcome numbers to match, none of which existed. They were invented as
 * layout filler alongside the sample case studies, and unlike the rest of
 * the invented copy on the site they were never routed through
 * `unverified()`, so they were shipping to production with made-up client
 * names attached to made-up percentages.
 *
 * Published case studies lead when there are any. Until then the section
 * shows real client work from data/credits.ts: named, live, linked, and
 * carrying the contribution rather than an outcome, because none of those
 * outcomes was measured by us.
 */
const published = await getWork();

const work = published.length
  ? published.slice(0, 3).map((e) => ({
      name: e.data.name,
      sector: e.data.sector,
      note: publishable(e.data.headline) ? e.data.headline.value : e.data.services[0],
      body: e.data.summary,
      href: `/work/${e.id}`,
      external: false,
    }))
  : credits.slice(0, 3).map((c) => ({
      name: c.name,
      sector: c.sector,
      note: c.contribution,
      body: c.what,
      href: c.site,
      external: true,
    }));

const differentiators = [
  { title: 'We learn the business first', body: 'Before any code, we map how your team actually operates. Most agencies skip this and build the wrong thing beautifully.' },
  { title: 'One team, one conversation', body: 'No account managers relaying messages. You talk to the people building your project, every time.' },
  { title: 'Honest scoping, not upselling', body: 'Sometimes the answer is a simple site, not a platform. We say so, even when it means a smaller invoice.' },
  { title: 'It works after we leave', body: 'You own everything and you understand everything. No hostage code, no mandatory retainer.' },
];

// Art per sector rather than per seed: a waveform behind healthcare is a
// vitals trace and behind energy it is metering; a node graph behind
// logistics is a route network. Without images these cards fell back to
// the build placeholder and rendered as blank slabs.
const industries = [
  { tag: 'Healthcare', label: 'Clinics & platforms', image: '/art/industry-healthcare.svg' },
  { tag: 'Logistics', label: 'Fleet & telematics', image: '/art/industry-logistics.svg' },
  { tag: 'Manufacturing', label: 'Industrial IoT', image: '/art/industry-manufacturing.svg' },
  { tag: 'E-commerce', label: 'D2C & retail', image: '/art/industry-ecommerce.svg' },
  { tag: 'Education', label: 'Schools & LMS', image: '/art/industry-education.svg' },
  { tag: 'Energy', label: 'Metering & monitoring', image: '/art/industry-energy.svg' },
  { tag: 'Fintech', label: 'Payments & portals', image: '/art/industry-fintech.svg' },
  { tag: 'Agriculture', label: 'Sensing & automation', image: '/art/industry-agriculture.svg' },
  { tag: 'Software', label: 'Products & platforms', image: '/art/industry-software.svg' },
];

// The final value ships in the HTML so it is present for crawlers and for
// reduced motion; the counter only rewinds it and plays it forward.
const stats = [
  { v: '65+', count: 65, prefix: '', suffix: '+', l: 'Projects delivered across web, hardware and automation' },
  // Estimated by us from delivered project outcomes, not reported back by
  // clients. The label has to carry that, because "average client ROI" reads
  // as a figure clients supplied and it is not one.
  { v: '36%', count: 36, prefix: '', suffix: '%', l: 'Estimated first-year ROI, from delivered project outcomes' },
  { v: '4', count: 4, prefix: '', suffix: '', l: 'Continents we ship to from one Karachi studio' },
];
---

<BaseLayout
  title="Xtenzium — We Architect Long-Term Success"
  description="Karachi-based digital agency building web products and the custom hardware underneath them. Web development, design, IoT, and AI automation."
  path="/"
>
  <Navbar />

  <main>
    <!-- ═══ 01 · Hero ═══════════════════════════════════════════ -->
    <section
      data-hero
      class="on-carbon relative flex min-h-screen items-end overflow-hidden bg-carbon pb-20 pt-36"
    >
      <canvas
        data-hero-canvas
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 h-full w-full"></canvas>

      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-r from-carbon via-carbon/85 to-transparent"
      >
      </div>

      {/* No data-exit here: the hero owns its own scroll-out through the
          parallax in hero.ts, and two systems writing y and opacity to one
          element is a fight neither wins. */}
      <div data-hero-content class="container-x relative z-10">
        <p data-hero-eyebrow class="eyebrow !text-white/55">
          Karachi, Pakistan — Software &amp; Hardware
        </p>

        <h1
          class="mt-5 max-w-4xl font-display text-[clamp(2.5rem,7vw,5.25rem)] font-bold leading-[1.0] tracking-[-0.035em] text-white"
        >
          {
            heroLines.map((line, i) => (
              <span data-hero-mask class="block overflow-hidden pb-2 -mb-2">
                <span data-hero-line class="block">
                  {i === 1 ? <span class="text-copper-hi">{line}</span> : line}
                </span>
              </span>
            ))
          }
        </h1>

        <p data-hero-body class="mt-8 max-w-xl text-lg leading-relaxed text-white/65">
          A digital agency building web products and the custom hardware
          underneath them. Sixty-five projects delivered for teams across four
          continents.
        </p>

        <div class="mt-10 flex flex-col items-start gap-3 sm:flex-row">
          <a
            data-hero-cta
            href="/work"
            class="inline-flex w-full items-center justify-center rounded-pill bg-copper px-7 py-3.5 text-sm font-bold text-white transition-colors duration-300 hover:bg-copper-hover sm:w-auto"
          >
            See the work
          </a>
          <a
            data-hero-cta
            href="/contact"
            class="inline-flex w-full items-center justify-center rounded-pill border border-white/60 bg-white/5 px-7 py-3.5 text-sm font-bold text-white backdrop-blur-sm transition-colors duration-300 hover:bg-white hover:text-carbon sm:w-auto"
          >
            Book a scoping call
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ 02 · Capability marquee ═════════════════════════════ -->
    <section class="border-b border-line bg-bg py-7">
      <div class="marquee" aria-label="Technologies we work with">
        {
          [0, 1].map((dup) => (
            <div class="marquee__track" aria-hidden={dup === 1 ? 'true' : undefined}>
              {capabilities.map((c) => (
                <span class="font-mono text-sm whitespace-nowrap text-ink-3">{c}</span>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ═══ 03 · Services — pinned horizontal gallery ═════════ -->
    <HorizontalGallery
      eyebrow="What we do"
      heading={['Software and hardware,', 'under one roof.']}
      items={services}
    />

    <!-- ═══ 04 · Statement — 'rise' ═════════════════════════════ -->
    <StatementPanel
      variant="rise"
      eyebrow="The difference"
      lines={['We build the', 'software and the', 'board it runs on.']}
      accentWord="board"
      imagery={imagery.statementDuality}
      meet="One team, one protocol"
      proof={[
        {
          label: 'The board',
          items: [
            'Schematic capture and PCB layout',
            'Firmware, RTOS and bootloaders',
            'LoRa, BLE, Zigbee, MQTT',
            'Design for manufacture and test fixtures',
          ],
        },
        {
          label: 'The software',
          items: [
            'React, Next.js and Astro',
            'Node, PostgreSQL and APIs',
            'Fleet dashboards and monitoring',
            'Over-the-air update pipelines',
          ],
        },
      ]}
    />

    <!-- ═══ 05 · Process — sticky stacking cards ══════════════ -->
    <StackingCards
      eyebrow="How it goes"
      heading={['Four steps, and you', 'see work at every one.']}
      items={process}
    />

    <!-- ═══ 06 · Selected work ══════════════════════════════════ -->
    <section class="bg-bg py-24 md:py-32">
      <div class="container-x" data-exit>
        <div
          data-reveal-group
          class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
        >
          <div class="max-w-xl">
            <p class="eyebrow" data-reveal="eyebrow">Selected work</p>
            <h2
              class="mt-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-[-0.03em] text-ink"
            >
              <span class="block" data-reveal="line">Proof, not promises.</span>
            </h2>
          </div>
          <a
            href="/work"
            data-reveal="body"
            class="shrink-0 rounded-pill border border-line-strong px-6 py-3 text-sm font-bold text-ink transition-colors duration-300 hover:bg-ink hover:text-bg"
          >
            View all case studies
          </a>
        </div>

        <div data-reveal-cards class="mt-14 grid gap-4 md:grid-cols-3">
          {
            work.map((w) => (
              <a
                href={w.href}
                target={w.external ? '_blank' : undefined}
                rel={w.external ? 'noopener noreferrer' : undefined}
                data-reveal="card"
                class="group flex flex-col rounded-card border border-line bg-surface p-8 transition-colors duration-300 hover:border-copper-line"
              >
                <p class="eyebrow">{w.sector}</p>
                <h3 class="mt-4 font-display text-xl font-bold tracking-[-0.025em] text-ink">
                  {w.name}
                  {w.external && (
                    <span aria-hidden="true" class="ml-1.5 text-ink-3">
                      &#8599;
                    </span>
                  )}
                </h3>
                <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-2">{w.body}</p>
                <p class="mt-6 font-display text-lg font-bold tracking-[-0.03em] text-copper">
                  {w.note}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ 06b · Testimonial ═════════════════════════════════ -->
    {/* Gated: invented quote and attribution. */}
    {unverified(true) && (
    <Testimonial
      quote="They didn't just ship a website. They built the thing our operations actually run on, and then handed it over so we could keep going without them."
      attribution="Operations Director"
      role="Fleet telematics client"
    />
    )}

    <!-- ═══ 07 · Stats ══════════════════════════════════════════ -->
    <!-- Numbers this big are the content. Boxing them shrinks them, so
         they run edge to edge on carbon and break the run of light. -->
    <section class="on-carbon relative overflow-hidden bg-carbon py-20 md:py-24">
      <WatermarkX side="right" size={40} opacity={12} drift={12} spin={7} />
      <div class="container-x relative z-10" data-exit>
        <div data-reveal-group>
          <p class="eyebrow !text-white/45" data-reveal="eyebrow">Track record</p>
        </div>

        <div
          data-reveal-cards
          class="mt-10 grid divide-y divide-white/10 sm:mt-12 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
        >
          {
            stats.map((s, i) => (
              <div
                data-reveal="card"
                class:list={['py-8 sm:py-0', i === 0 ? 'sm:pr-10' : 'sm:px-10', i === 2 && 'sm:pr-0']}
              >
                <div
                  data-count-to={s.count}
                  data-count-prefix={s.prefix}
                  data-count-suffix={s.suffix}
                  class="font-display text-[clamp(3.5rem,9vw,6.5rem)] font-bold leading-[0.9] tracking-[-0.05em] text-copper-hi tabular-nums"
                >
                  {s.v}
                </div>
                <p class="mt-4 max-w-[16rem] text-sm leading-relaxed text-white/55">{s.l}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ 08 · Why us ═════════════════════════════════════════ -->
    <section class="bg-bg py-24 md:py-32">
      <div class="container-x" data-exit>
        <div data-reveal-group class="max-w-2xl">
          <p class="eyebrow" data-reveal="eyebrow">Why Xtenzium</p>
          <h2
            class="mt-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-[-0.03em] text-ink"
          >
            <span class="block" data-reveal="line">Why it matters for</span>
            <span class="block" data-reveal="line">your business.</span>
          </h2>
        </div>

        <!-- Even 2x2, not a bento.
             The asymmetric version gave four equal-weight claims unequal
             sizes, which read as arbitrary rather than considered, and the
             large corner blur left every card top-heavy with dead space.
             Equal tiles, content from the top, and a hairline rule that
             lights up on hover — the accent is a line, not a cloud. -->
        <div data-reveal-cards class="mt-14 grid gap-4 md:grid-cols-2">
          {
            differentiators.map((d, i) => (
              <article
                data-reveal="card"
                class="group relative overflow-hidden rounded-card border border-white/10 bg-carbon p-8 md:p-9"
              >
                <span
                  aria-hidden="true"
                  class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-copper/70 via-copper/20 to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100"
                />

                <div class="flex items-baseline gap-4">
                  <span class="font-mono text-xs text-copper">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="font-display text-xl font-bold tracking-[-0.025em] text-white">
                    {d.title}
                  </h3>
                </div>

                <p class="mt-4 max-w-md pl-9 text-[0.95rem] leading-relaxed text-white/60">
                  {d.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ 09 · Statement — 'focus' ════════════════════════════ -->
    <StatementPanel
      variant="focus"
      eyebrow="Built, not assembled"
      lines={['Your brand deserves', 'more than a template.']}
      accentWord="template"
      imagery={imagery.statementTemplate}
      cta={{ label: 'See how we scope it', href: '/estimate' }}
    />

    <!-- ═══ 10 · Industries — 3D coverflow ════════════════════ -->
    <Coverflow
      eyebrow="Industries"
      heading={['Built for every business.']}
      blurb="Real projects for real businesses, from clinics and fleets to factory floors."
      items={industries}
    />

    <!-- ═══ 11 · Contact — graduated commitment ═════════════════ -->
    <section id="contact" class="relative overflow-hidden bg-bg py-24 md:py-32">
      <WatermarkX side="left" size={36} opacity={5} drift={9} spin={5} tone="dark" />
      <div class="container-x relative z-10" data-exit>
        <div data-reveal-group class="max-w-3xl">
          <p class="eyebrow" data-reveal="eyebrow">Start here</p>
          <h2
            class="mt-3 font-display text-[clamp(2rem,5vw,3.5rem)] font-bold tracking-[-0.035em] text-ink"
          >
            <span class="block" data-reveal="line">Tell us what you're</span>
            <span class="block" data-reveal="line">trying to build.</span>
          </h2>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-ink-2" data-reveal="body">
            Most projects start months before anyone signs anything. Pick
            whichever step you're actually on — none of them commit you.
          </p>
        </div>

        <!-- Three rungs, lightest first. A single "contact us" is the wrong
             ask when the average decision runs 3-18 months across 6-10 people. -->
        <div data-reveal-cards class="mt-12 grid gap-4 md:grid-cols-3">
          <div data-reveal="card" class="flex flex-col rounded-card border border-line bg-surface p-8">
            <p class="eyebrow">Just looking</p>
            <h3 class="mt-4 font-display text-xl font-bold tracking-[-0.025em] text-ink">
              Read a case study
            </h3>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-2">
              How we scoped, what it cost, what broke, and what it returned. No
              form, no email required.
            </p>
            <a
              href="/work"
              class="mt-6 inline-flex items-center justify-center rounded-pill border border-line-strong px-6 py-3 text-sm font-bold text-ink transition-colors duration-300 hover:bg-ink hover:text-bg"
            >
              Browse the work
            </a>
          </div>

          <div data-reveal="card" class="flex flex-col rounded-card border border-line bg-surface p-8">
            <p class="eyebrow">Comparing options</p>
            <h3 class="mt-4 font-display text-xl font-bold tracking-[-0.025em] text-ink">
              Get a ballpark
            </h3>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-2">
              Answer four questions and get a realistic range by email — enough
              to take to whoever holds the budget.
            </p>
            <a
              href="/estimate"
              class="mt-6 inline-flex items-center justify-center rounded-pill border border-line-strong px-6 py-3 text-sm font-bold text-ink transition-colors duration-300 hover:bg-ink hover:text-bg"
            >
              Estimate a project
            </a>
          </div>

          <div
            data-reveal="card"
            class="on-carbon flex flex-col rounded-card border border-carbon bg-carbon p-8"
          >
            <p class="eyebrow !text-copper-hi">Ready to talk</p>
            <h3 class="mt-4 font-display text-xl font-bold tracking-[-0.025em] text-white">
              Book a scoping call
            </h3>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-white/60">
              Thirty minutes with the people who'd build it. You leave with a
              written scope and a number, free either way.
            </p>
            <a
              href="/contact"
              class="mt-6 inline-flex items-center justify-center rounded-pill bg-copper px-6 py-3 text-sm font-bold text-white transition-colors duration-300 hover:bg-copper-hover"
            >
              Pick a time
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

---
import Logo from './Logo.astro';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/journal', label: 'Journal' },
];
---

<header data-nav class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center pt-4 md:pt-6">
  <div class="w-full max-w-3xl px-4">
    <nav
      data-nav-shell
      class="nav-shell pointer-events-auto flex items-center justify-between gap-5 rounded-pill border border-white/12 bg-carbon/70 py-2 pl-5 pr-2 shadow-[0_8px_32px_-12px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-[background-color,border-color,box-shadow] duration-300"
    >
      <a href="/" class="flex items-center gap-2.5" aria-label="Xtenzium — home">
        <Logo size={26} labelled={false} />
        <span class="font-display text-base font-bold tracking-[-0.03em] text-white">
          Xtenzium
        </span>
      </a>

      <ul class="hidden items-center gap-6 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm font-medium text-white/70 transition-colors duration-300 hover:text-white"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-1.5">
        <a
          href="/contact"
          aria-label="Start a project"
          class="grid h-9 w-9 place-items-center rounded-full bg-copper text-white transition-colors duration-300 hover:bg-copper-hover"
        >
          <span aria-hidden="true" class="text-sm">&#8599;</span>
        </a>
        <a
          href="tel:+920000000000"
          aria-label="Call the studio"
          class="hidden h-9 w-9 place-items-center rounded-full border border-white/15 text-white/80 transition-colors duration-300 hover:border-white/40 hover:text-white sm:grid"
        >
          <span aria-hidden="true" class="text-xs">&#9742;</span>
        </a>
        <button
          type="button"
          aria-label="Open menu"
          class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/80 transition-colors duration-300 hover:border-white/40 hover:text-white"
        >
          <span aria-hidden="true" class="text-xs">&#9776;</span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Once anything is scrolled behind it, the nav stops being a floating
     translucent pill and becomes a solid bar. Colour and shadow only —
     animating padding here would relayout the whole header on scroll. */
  .nav-shell.is-scrolled {
    background-color: color-mix(in srgb, var(--color-carbon) 92%, transparent);
    border-color: color-mix(in srgb, #ffffff 18%, transparent);
    box-shadow: 0 10px 40px -14px rgb(0 0 0 / 0.75);
  }
</style>

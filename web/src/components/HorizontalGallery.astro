---
import BleedImage from './BleedImage.astro';
import type { Imagery } from '../data/imagery';

interface Item {
  kicker: string;
  title: string;
  body: string;
  href: string;
  image?: Imagery;
}
interface Props {
  eyebrow: string;
  heading: string[];
  items: Item[];
}
const { eyebrow, heading, items } = Astro.props;
---

<section data-hgallery class="relative overflow-hidden bg-carbon on-carbon py-24 md:py-28">
  <div class="container-x" data-reveal-group>
    <p class="eyebrow !text-white/45" data-reveal="eyebrow">{eyebrow}</p>
    <h2
      class="mt-3 max-w-2xl font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-[-0.03em] text-white"
    >
      {heading.map((l) => <span class="block" data-reveal="line">{l}</span>)}
    </h2>
  </div>

  <div class="mt-14 overflow-hidden">
    <div
      data-hgallery-track
      class="flex gap-5 px-6 md:px-10 [[data-hgallery-native]_&]:snap-x [[data-hgallery-native]_&]:snap-mandatory [[data-hgallery-native]_&]:overflow-x-auto [[data-hgallery-native]_&]:pb-4"
    >
      {/* Cards are shorter than they were: at 30rem the label sat 413px
          down a 480px card, which on a laptop put every service name
          below the fold — the reader scrolled past a row of abstract art
          with nothing to say what any of it was. */}
      {
        items.map((item, i) => (
          <a
            href={item.href}
            class="group relative flex h-[23rem] w-[19rem] flex-none snap-start flex-col justify-end overflow-hidden rounded-card border border-white/10 md:h-[25rem] md:w-[23rem]"
          >
            {item.image && (
              <BleedImage image={item.image} scrim="soft" class="!absolute" />
            )}

            <span class="absolute left-5 top-5 z-10 rounded-pill border border-white/25 bg-black/30 px-3 py-1.5 font-mono text-[11px] text-white/80 backdrop-blur-sm">
              {String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}
            </span>

            <div class="relative z-10 p-6">
              <p class="eyebrow !text-copper-hi">{item.kicker}</p>
              <h3 class="mt-2.5 font-display text-2xl font-bold tracking-[-0.03em] text-white">
                {item.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/60 transition-colors duration-500 group-hover:text-white/85">
                {item.body}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

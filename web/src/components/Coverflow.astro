---
interface Item {
  tag: string;
  label: string;
  /** Generated brand art, chosen per sector. */
  image?: string;
}
interface Props { eyebrow: string; heading: string[]; blurb?: string; items: Item[]; href?: string }
const { eyebrow, heading, blurb, items, href = '/work' } = Astro.props;
---

<section class="overflow-hidden bg-bg-alt py-20 md:py-28">
  <div class="container-x text-center" data-reveal-group>
    <p class="eyebrow" data-reveal="eyebrow">{eyebrow}</p>
    <h2
      class="mx-auto mt-3 max-w-2xl font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-[-0.03em] text-ink"
    >
      {heading.map((l) => <span class="block" data-reveal="line">{l}</span>)}
    </h2>
    {blurb && <p class="mx-auto mt-4 max-w-lg leading-relaxed text-ink-2" data-reveal="body">{blurb}</p>}
  </div>

  {/* A perspective stage. Cards are absolutely centred and every one of
      their transforms comes from JS, so this element only supplies the
      depth and the bounds. */}
  <div
    data-coverflow
    tabindex="0"
    role="group"
    aria-roledescription="carousel"
    aria-label={`${eyebrow} — drag, or use the arrow keys`}
    class="relative mx-auto mt-14 h-[26rem] w-full max-w-6xl cursor-grab touch-pan-y select-none [perspective:1800px] focus-visible:outline-none md:h-[30rem] [&.is-dragging]:cursor-grabbing [[data-coverflow-flat]&]:flex [[data-coverflow-flat]&]:h-auto [[data-coverflow-flat]&]:cursor-auto [[data-coverflow-flat]&]:snap-x [[data-coverflow-flat]&]:snap-mandatory [[data-coverflow-flat]&]:gap-5 [[data-coverflow-flat]&]:overflow-x-auto [[data-coverflow-flat]&]:px-6 [[data-coverflow-driven]&]:!overflow-hidden [[data-coverflow-driven]&]:!snap-none [[data-coverflow-driven]&]:cursor-default [[data-coverflow-flat]&]:[perspective:none]"
  >
    <div
      data-coverflow-stage
      class="absolute inset-0 [transform-style:preserve-3d] [[data-coverflow-flat]_&]:static [[data-coverflow-flat]_&]:flex [[data-coverflow-flat]_&]:gap-5"
    >
      {
        items.map((item) => (
          <article
            data-coverflow-card
            class="on-carbon group absolute left-1/2 top-1/2 h-[21rem] w-[15rem] overflow-hidden rounded-card border border-white/10 bg-carbon shadow-[0_28px_70px_-28px_rgba(10,9,8,0.6)] transition-[border-color] duration-300 [transform-style:preserve-3d] hover:border-copper/50 md:h-[25rem] md:w-[18rem] [&.is-focused]:border-copper/60 [[data-coverflow-flat]_&]:static [[data-coverflow-flat]_&]:flex-none [[data-coverflow-flat]_&]:snap-start"
          >
            {item.image && (
              <img
                src={item.image}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
              />
            )}
            <span
              aria-hidden="true"
              class="absolute inset-0 bg-gradient-to-t from-carbon via-carbon/50 to-transparent"
            />
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-copper/70 via-copper/20 to-transparent"
            />
            <div class="relative z-10 flex h-full flex-col justify-end p-6">
              <p class="eyebrow !text-copper-hi">{item.tag}</p>
              <p
                data-coverflow-label
                class="mt-1.5 font-display text-xl font-bold tracking-[-0.02em] text-white"
              >
                {item.label}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* WCAG 2.2 requires a single-pointer alternative to any drag, so these
      and the arrow keys are the accessible path — the drag is the
      pleasant one. */}
  <p data-coverflow-status role="status" aria-live="polite" class="sr-only"></p>

  <div data-coverflow-controls class="mt-8 flex items-center justify-center gap-3">
    <button
      type="button"
      data-coverflow-prev
      aria-label="Previous industries"
      class="grid h-11 w-11 place-items-center rounded-pill border border-line-strong text-ink transition-colors duration-300 hover:border-copper hover:text-copper"
    >
      <span aria-hidden="true">&larr;</span>
    </button>
    <button
      type="button"
      data-coverflow-next
      aria-label="Next industries"
      class="grid h-11 w-11 place-items-center rounded-pill border border-line-strong text-ink transition-colors duration-300 hover:border-copper hover:text-copper"
    >
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>

  <div class="container-x mt-10 text-center">
    <a
      href={href}
      class="inline-flex items-center gap-2 text-sm font-bold text-ink transition-colors duration-300 hover:text-copper"
    >
      View full portfolio <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

---
import type { Imagery } from '../data/imagery';

/**
 * Full-bleed image ground.
 *
 * Two layers: generated art painted first, photograph over it. The art is the
 * fallback — if the photo is slow, blocked or removed, the slot still reads
 * as designed instead of going black, and there is no layout shift either way.
 *
 * The photo is desaturated and has copper blended over it, so twelve
 * unrelated stock photographs read as one branded set rather than a stock
 * library. Turn that off with treatment="none" once real commissioned
 * photography exists that is already on-palette.
 */
interface Props {
  image: Imagery;
  /**
   * Drift the ground against the scroll.
   *
   * Opt-in rather than automatic: this belongs on a section-sized frame,
   * where a slow-moving ground behind faster copy reads as depth. On the
   * small cards inside the horizontal gallery it would be a second axis of
   * movement on something already travelling sideways, which reads as
   * drift rather than as design.
   *
   * Emits the markup lib/parallax.ts already drives, so there is one
   * implementation of this effect on the site rather than two.
   */
  parallax?: boolean;
  /** Darkens for legibility. Statement panels need more than headers. */
  scrim?: 'none' | 'soft' | 'strong' | 'left';
  treatment?: 'duotone' | 'none';
  eager?: boolean;
  class?: string;
}

const {
  image,
  parallax = false,
  scrim = 'soft',
  treatment = 'duotone',
  eager = false,
  class: className = '',
} = Astro.props;

const scrims: Record<string, string> = {
  none: '',
  soft: 'bg-gradient-to-t from-carbon via-carbon/55 to-carbon/70',
  strong: 'bg-gradient-to-t from-carbon via-carbon/75 to-carbon/85',
  left: 'bg-gradient-to-r from-carbon via-carbon/80 to-carbon/40',
};
---

<div
  class:list={['pointer-events-none absolute inset-0 overflow-hidden bg-carbon', className]}
  aria-hidden="true"
  data-parallax={parallax ? '' : undefined}
  data-parallax-strength={parallax ? '18' : undefined}
>
  {/* Ground: always present, paints instantly, survives a dead photo. */}
  <img
    src={image.art}
    alt=""
    aria-hidden="true"
    decoding="async"
    data-parallax-img={parallax ? '' : undefined}
    class="absolute inset-0 h-full w-full object-cover"
  />

  {
    image.photo && (
      <div class:list={['absolute inset-0', treatment === 'duotone' && 'duotone']}>
        <img
          src={image.photo}
          srcset={`${image.photoSmall} 900w, ${image.photo} 2000w`}
          sizes="100vw"
          alt={image.alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    )
  }

  {scrim !== 'none' && <div class:list={['absolute inset-0', scrims[scrim]]} />}
</div>

<style>
  /* Graded, not repainted.

     This was `mix-blend-mode: color` at 0.85 over `grayscale(1)` and
     `brightness(.62)` — a full hue replacement, which is a true duotone
     and was the problem. At that strength the photograph contributes
     nothing but dimmed luminance: every slot came out the same muddy
     orange, the subject stopped being legible, and a circuit board read
     as a texture rather than as a circuit board.

     `soft-light` tints instead of replacing. The image keeps its own
     colour underneath a copper cast, so twelve unrelated photographs
     still read as one set — which is the whole point of treating them —
     while each one still reads as itself. Copper then does its real job
     as an accent in the interface rather than as a wash over everything
     behind it. */
  .duotone img {
    filter: grayscale(0.8) contrast(1.08) brightness(0.68);
  }
  .duotone::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-copper);
    mix-blend-mode: soft-light;
    opacity: 0.45;
  }
  /* A soft copper lift so the darkest areas do not read as flat black. */
  .duotone::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      90% 70% at 25% 35%,
      color-mix(in srgb, var(--color-copper) 16%, transparent) 0%,
      transparent 62%
    );
  }
</style>

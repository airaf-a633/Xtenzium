---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/work" — combined with site for the canonical. */
  path?: string;
  image?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-image.png',
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

/**
 * Breadcrumbs, derived from the path rather than declared per page.
 *
 * Two things this buys, and one thing it does not:
 *
 *  - Google renders a breadcrumb trail in place of the raw URL in a
 *    result, so "Xtenzium › Work › Dinely" appears instead of a slug.
 *  - It states the hierarchy explicitly. A crawler that has indexed one
 *    case study now has a labelled link to /work, which is the parent it
 *    would otherwise have to infer from the nav on every page.
 *  - It does not help anything rank. Nothing on this page does; the site
 *    is new and thin on links, and that is a content problem.
 *
 * Deriving it from `path` means it cannot drift out of step with the
 * URL, which is exactly how hand-written breadcrumb markup goes stale.
 * Only the segments that are real pages get a name here; anything not
 * listed falls back to its slug in title case, which is right for
 * /work/dinely and would be wrong for a segment that is not a page.
 */
const SEGMENT_NAMES: Record<string, string> = {
  work: 'Work',
  services: 'Services',
  journal: 'Journal',
};

const segments = path.split('/').filter(Boolean);
const titleCase = (slug: string) =>
  slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const breadcrumbs =
  segments.length === 0
    ? []
    : [
        { name: 'Home', item: new URL('/', Astro.site).href },
        ...segments.map((segment, i) => ({
          // The last crumb is this page, so it takes the page's own title
          // rather than a guess made from the slug.
          name:
            i === segments.length - 1
              ? (SEGMENT_NAMES[segment] ?? title.split('—')[0].trim() ?? titleCase(segment))
              : (SEGMENT_NAMES[segment] ?? titleCase(segment)),
          item: new URL(`/${segments.slice(0, i + 1).join('/')}/`, Astro.site).href,
        })),
      ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Search Console. Verification is a property of the site
         rather than of any one page, so it belongs in the shared layout —
         Google may re-check it against any URL it has indexed, not only
         the home page. -->
    <meta
      name="google-site-verification"
      content="XEii5ZkTUAtE1Mz4a7S1ZBdn_yIoz-52MbBtfT26vFI"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xtenzium" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="PK-SD" />
    <meta name="geo.placename" content="Karachi, Pakistan" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:opsz,wght@9..40,400..700&family=DM+Mono:wght@400;500&display=swap"
    />

    {breadcrumbs.length > 1 && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbs.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: crumb.item,
          })),
        })}
      />
    )}

    <ClientRouter />
    <slot name="head" />
  </head>

  <body>
    <!-- Bypass block (WCAG 2.4.1). Off-screen until focused, then it lands
         in the top-left as the first tab stop — a keyboard reader should
         not have to walk the whole nav on every page to reach the content
         they came for. -->
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-[70] focus-visible:rounded-pill focus-visible:bg-copper focus-visible:px-5 focus-visible:py-3 focus-visible:text-sm focus-visible:font-bold focus-visible:text-white"
    >
      Skip to content
    </a>

    <!-- Reading progress. Driven by scale, never width. -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-[2px]">
      <div data-progress class="h-full origin-left bg-copper" style="scale: 0 1;"></div>
    </div>

    <slot />

    {/* A quiet prompt for a reader who is leaving. A corner panel rather
        than a modal: it covers nothing, traps no focus, and the page stays
        usable behind it. It offers what is already on offer everywhere
        else — nothing is withheld in order to create the ask, because
        withholding something to extract an email is the move this site is
        positioned against. */}
    <aside
      data-exit-prompt
      hidden
      aria-label="Before you go"
      class="fixed bottom-5 right-5 z-[65] w-[min(22rem,calc(100vw-2.5rem))] rounded-card border border-white/12 bg-carbon p-6 shadow-[0_24px_60px_-20px_rgba(10,9,8,0.7)]"
    >
      <button
        type="button"
        data-exit-prompt-close
        aria-label="Dismiss"
        class="absolute right-3 top-3 grid h-8 w-8 place-items-center rounded-full text-white/40 transition-colors duration-300 hover:bg-white/10 hover:text-white"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <p class="eyebrow !text-copper-hi">Before you go</p>
      <p class="mt-3 font-display text-lg font-bold leading-snug tracking-[-0.02em] text-white">
        Most projects start months before anyone signs anything.
      </p>
      <p class="mt-2.5 text-sm leading-relaxed text-white/55">
        Get a realistic range in four questions, or thirty minutes with the
        people who would build it. Neither commits you to anything.
      </p>

      <div class="mt-5 flex flex-wrap gap-2.5">
        <a
          href="/estimate"
          class="inline-flex items-center justify-center rounded-pill bg-copper px-5 py-2.5 text-sm font-bold text-white transition-colors duration-300 hover:bg-copper-hover"
        >
          Estimate a project
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-pill border border-white/25 px-5 py-2.5 text-sm font-bold text-white transition-colors duration-300 hover:bg-white hover:text-carbon"
        >
          Book a call
        </a>
      </div>
    </aside>

    <script>
      import { initSmoothScroll, destroySmoothScroll, syncSmoothScroll } from '../lib/smooth-scroll';
      import { initReveal, destroyReveal } from '../lib/reveal';
      import { initSplit, destroySplit } from '../lib/split';
      import { initSectionExit, destroySectionExit } from '../lib/section-exit';
      import { initAnchorScroll, destroyAnchorScroll } from '../lib/anchor-scroll';
      import { initExitPrompt, destroyExitPrompt } from '../lib/exit-prompt';
      import { initAnalytics, destroyAnalytics } from '../lib/analytics';
      import { initStatementPanels, destroyStatementPanels } from '../lib/statement-panel';
      import { initHero, destroyHero } from '../lib/hero';
      import { initCounters, destroyCounters } from '../lib/counter';
      import { initParallax, destroyParallax } from '../lib/parallax';
      import { initStackingCards, destroyStackingCards } from '../lib/stacking-cards';
      import { initHorizontalGallery, destroyHorizontalGallery } from '../lib/horizontal-gallery';
      import { initCoverflow, destroyCoverflow } from '../lib/coverflow';
      import { initEstimate } from '../lib/estimate';
      import { initContact } from '../lib/contact';
      import { initWatermarks, destroyWatermarks } from '../lib/watermark';
      import { initChrome, destroyChrome } from '../lib/chrome';
      import { initFaq, destroyFaq } from '../lib/faq';
      import { initQuotes, destroyQuotes } from '../lib/quote';
      import { initMenu, destroyMenu } from '../lib/menu';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      let running = false;

      function start() {
        // `astro:page-load` also fires on the very first load, so without
        // this guard every init runs twice: two Lenis instances, two sets
        // of ScrollTriggers, and a second gsap.set() that re-hides elements
        // the first pass had already armed.
        if (running) return;
        running = true;
        initSmoothScroll();
        initHero();
        initReveal();
        initSplit();
        initSectionExit();
        initAnchorScroll();
        initExitPrompt();
        initAnalytics();
        initStatementPanels();
        initCounters();
        initParallax();
        initStackingCards();
        initHorizontalGallery();
        initCoverflow();
        initEstimate();
        initContact();
        initWatermarks();
        initChrome();
        initFaq();
        initQuotes();
        initMenu();

        // Pins add scroll length, which invalidates the geometry of every
        // trigger further down the page. Modules are initialised in DOM
        // order but a pin created late still shifts what came before it in
        // init order, so sort by document position and recalculate once
        // everything exists. Without this the stacking cards measure their
        // start ~1160px early -- exactly the horizontal gallery's pin
        // distance -- and render their end state before you reach them.
        ScrollTrigger.sort();
        ScrollTrigger.refresh();

        // Web fonts and lazy images settle after this point and change
        // element heights, so measure once more when the page is fully
        // loaded. Cheap, and it is the difference between a pinned section
        // being a few hundred pixels out and being exact.
        if (document.readyState !== 'complete') {
          window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
        }
        if (import.meta.env.DEV) {
          Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([g, st]) => {
            (window as any).gsap = g.default;
            (window as any).ScrollTrigger = st.ScrollTrigger;
          });
        }
      }

      function stop() {
        if (!running) return;
        running = false;
        destroyHero();
        destroyReveal();
        // Reverts the split, putting the original text back in the DOM
        // before the page swaps — a view transition must never capture
        // generated line wrappers.
        destroySplit();
        destroySectionExit();
        destroyAnchorScroll();
        destroyExitPrompt();
        destroyAnalytics();
        destroyStatementPanels();
        destroyCounters();
        destroyParallax();
        destroyStackingCards();
        destroyHorizontalGallery();
        destroyCoverflow();
        destroyWatermarks();
        destroyChrome();
        destroyFaq();
        destroyQuotes();
        destroyMenu();
        destroySmoothScroll();
      }

      // ── Scroll restoration ──────────────────────────────────────────
      // Manual, so a fresh visit always lands at the top and only
      // back/forward restores a saved position.
      const nav = performance.getEntriesByType('navigation')[0] as
        | PerformanceNavigationTiming
        | undefined;
      const isBackForward = nav?.type === 'back_forward';

      if ('scrollRestoration' in history) {
        history.scrollRestoration = isBackForward ? 'auto' : 'manual';
      }

      const key = 'xtz:scroll:' + location.pathname;

      if (isBackForward) {
        requestAnimationFrame(() => {
          if (window.scrollY === 0) {
            const saved = sessionStorage.getItem(key);
            if (saved) window.scrollTo(0, parseInt(saved, 10) || 0);
          }
        });
      } else {
        window.scrollTo(0, 0);
      }

      window.addEventListener('pagehide', () => {
        try {
          sessionStorage.setItem('xtz:scroll:' + location.pathname, String(window.scrollY));
        } catch {
          /* private mode — not worth failing over */
        }
      });

      // ── Lifecycle ───────────────────────────────────────────────────
      // No direct start() call — `astro:page-load` fires on first load too.

      // The transition itself is CSS now — ::view-transition-old/new in
      // global.css. The browser snapshots the old page, swaps, and
      // animates between the two, which is both faster than driving
      // opacity from JS and the only way the `transition:name` headings
      // can morph: a full-page fade painted straight over them.
      //
      // Nothing here delays navigation any more. The previous version
      // held the loader open for 300ms to let a fade finish, which made
      // every click cost that 300ms even when the page was already
      // prefetched.
      document.addEventListener('astro:before-swap', () => {
        stop();
      });

      document.addEventListener('astro:after-swap', () => {
        window.scrollTo(0, 0);
      });

      document.addEventListener('astro:page-load', () => {
        start();
      });

      let resizeTimer: number;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(syncSmoothScroll, 250);
      });
    </script>
  </body>
</html>

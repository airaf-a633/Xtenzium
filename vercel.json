{
  "rewrites": [
    {
      "source": "/crm",
      "destination": "/crm/index.html"
    },
    {
      "source": "/crm/:path*",
      "destination": "/crm/index.html"
    },
    {
      "source": "/admin",
      "destination": "/crm/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/crm/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/gsc-sync",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/c/(.*).vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}
